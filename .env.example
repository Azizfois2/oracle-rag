# Copy this file to .env, then fill in your own values:
#
#   Copy-Item .env.example .env
#
# The Gemini key is optional. Without it the console runs in local mode, which
# still searches the corpus and shows sources but does not call a model.

# Oracle connection used by the console and the tools in tools/.
# The one-click setup creates the user "vector" with this password.
ORACLE_USER=vector
ORACLE_PWD=vector
ORACLE_DSN=localhost:1521/FREEPDB1

# Optional: a different table, the local embedding model, and the local
# reranker. Leave these out to use the defaults shown here. The reranker runs
# on the CPU and costs no API quota; it downloads once on first use.
RAG_TABLE=TECH_NEWS_COLLECTION
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L12-v2
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional: Gemini. Leave the key empty to stay in local mode.
GEMINI_API_KEY=

# Optional: pin one model. Empty means "try the list in rag_core.py in order".
GEMINI_MODEL=

# Free-tier requests per day, per model. 20 is the usual free limit.
GEMINI_DAILY_LIMIT=20
